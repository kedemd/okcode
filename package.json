{
    "name": "@kedem/okcode",
    "version": "0.1.3",
    "description": "Agentless workspace tools: find, read and edit code by name in local or remote workspaces — indexed with okdb (symbols, full-text, embeddings), content never copied.",
    "main": "src/okcode.js",
    "bin": {
        "okcode": "bin/okcode.js"
    },
    "files": [
        "src",
        "bin",
        "docs/ACCESS.md",
        "docs/DESIGN.md",
        "README.md",
        "grammars"
    ],
    "scripts": {
        "test": "node --test --test-force-exit test/*.test.js",
        "vendor-grammars": "node scripts/vendor-grammars.js"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@kedem/okdb": "^2.4.0",
        "acorn": "^8.18.0"
    },
    "peerDependencies": {
        "@kedem/okjs": ">=1.3.0"
    },
    "peerDependenciesMeta": {
        "@kedem/okjs": {
            "optional": true
        }
    },
    "optionalDependencies": {
        "web-tree-sitter": "^0.27.1"
    },
    "license": "MIT",
    "devDependencies": {
        "@kedem/okjs": "~1.3.1",
        "tree-sitter-typescript": "^0.23.2",
        "tree-sitter-python": "^0.25.0",
        "tree-sitter-go": "^0.25.0",
        "tree-sitter-rust": "^0.24.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedemd/okcode.git"
    }
}
