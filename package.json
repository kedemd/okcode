{
    "name": "@kedem/okcode",
    "version": "1.0.3",
    "description": "Agentless workspace tools: find, read and edit code by name in local or remote workspaces — indexed with okdb (symbols, full-text, embeddings), content never copied.",
    "main": "lib/okcode.js",
    "bin": {
        "okcode": "bin/okcode.js"
    },
    "files": [
        "native",
        "lib",
        "bin",
        "docs/ACCESS.md",
        "docs/DESIGN.md",
        "docs/UPGRADING.md",
        "docs/NATIVE.md",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "test": "node --test --test-force-exit test/*.test.js",
        "build": "node scripts/release/build.js",
        "check": "node scripts/release/check.js",
        "test:dist": "node scripts/release/test-dist.js",
        "publish": "node scripts/release/publish.js",
        "release": "node scripts/release/release.js"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@kedem/okdb": "^3.0.1"
    },
    "license": "MIT",
    "devDependencies": {
        "@kedem/okjs": "~1.3.1"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kedemd/okcode.git"
    }
}
